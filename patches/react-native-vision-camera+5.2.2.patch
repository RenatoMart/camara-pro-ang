+package com.margelo.nitro.camera.hybrids
+
+import android.hardware.camera2.CaptureResult
+import android.hardware.camera2.TotalCaptureResult
+import android.hardware.camera2.params.RggbChannelVector
+
+/**
+ * PATCH CamaraProAng: último resultado de captura real — el ISO/velocidad/WB
+ * que el 3A automático está aplicando de verdad ahora mismo, no un rango
+ * estático de `CameraCharacteristics`.
+ *
+ * Sirve para arrancar los controles manuales (`HybridCameraController`)
+ * desde el valor que ya se está viendo en el visor en vez de uno inventado:
+ * sin esto, pasar de automático a manual daba un salto brusco de exposición
+ * o de color, porque el punto de partida no tenía nada que ver con lo que
+ * el usuario estaba viendo un instante antes.
+ *
+ * Lo alimenta `HybridPreviewOutput.createUseCase`, enganchando
+ * `Camera2Interop.Extender.setSessionCaptureCallback` al `Preview` — es la
+ * única forma de leer esto en CameraX: no hay API pública para resultados de
+ * captura en vivo, y el enganche tiene que ir al construir el `UseCase`, no
+ * se puede añadir después sobre uno ya vinculado (por eso vive en el
+ * `Preview`, que siempre está presente mientras hay visor, y no en
+ * `HybridCameraController`, que sólo tiene la `Camera` ya vinculada).
+ *
+ * Es un único estado global y no uno por cámara: esta app sólo mantiene una
+ * sesión de cámara activa a la vez, así que no hace falta más — cambiar de
+ * cámara (frontal/trasera) reconstruye el `Preview` y `reset()` limpia lo
+ * anterior antes de que lleguen resultados nuevos.
+ */
+object LiveCameraCaptureState {
+  @Volatile
+  var isoValue: Int? = null
+    private set
+
+  @Volatile
+  var exposureDurationNs: Long? = null
+    private set
+
+  @Volatile
+  var whiteBalanceGains: RggbChannelVector? = null
+    private set
+
+  fun reset() {
+    isoValue = null
+    exposureDurationNs = null
+    whiteBalanceGains = null
+  }
+
+  fun update(result: TotalCaptureResult) {
+    result.get(CaptureResult.SENSOR_SENSITIVITY)?.let { isoValue = it }
+    result.get(CaptureResult.SENSOR_EXPOSURE_TIME)?.let { exposureDurationNs = it }
+    result.get(CaptureResult.COLOR_CORRECTION_GAINS)?.let { whiteBalanceGains = it }
+  }
+}
